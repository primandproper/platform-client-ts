{
  "name": "@primandproper/platform-client",
  "version": "0.0.0",
  "private": true,
  "description": "Client for services built on platform-go",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./audit/v1": "./dist/audit/v1.mjs",
    "./billing/v1": "./dist/billing/v1.mjs",
    "./comments/v1": "./dist/comments/v1.mjs",
    "./filtering/v1": "./dist/filtering/v1.mjs",
    "./identity/v1": "./dist/identity/v1.mjs",
    "./issuereports/v1": "./dist/issuereports/v1.mjs",
    "./notifications/v1": "./dist/notifications/v1.mjs",
    "./oauth2clients/v1": "./dist/oauth2clients/v1.mjs",
    "./passwordreset/v1": "./dist/passwordreset/v1.mjs",
    "./settings/v1": "./dist/settings/v1.mjs",
    "./signin/v1": "./dist/signin/v1.mjs",
    "./testing": "./dist/testing.mjs",
    "./waitlists/v1": "./dist/waitlists/v1.mjs",
    "./webhooks/v1": "./dist/webhooks/v1.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config-loader native",
    "fetch-protos": "./scripts/fetch-protos.sh",
    "generate": "./scripts/generate.sh",
    "codegen": "pnpm run fetch-protos && pnpm run generate",
    "test": "vitest run",
    "check-build": "./scripts/check-build.sh",
    "check-consumer": "./scripts/check-consumer.sh"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.10.1",
    "@grpc/grpc-js": "1.14.3",
    "@types/node": "22.13.1",
    "prettier": "3.6.2",
    "ts-proto": "2.11.5",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.10.1",
    "@grpc/grpc-js": "^1.14.3"
  },
  "packageManager": "pnpm@10.33.0"
}
