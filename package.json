{
  "name": "@primandproper/platform-client",
  "version": "0.0.0",
  "private": true,
  "description": "Client for services built on platform-go",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config-loader native",
    "fetch-protos": "./scripts/fetch-protos.sh",
    "generate": "./scripts/generate.sh",
    "codegen": "pnpm run fetch-protos && pnpm run generate",
    "test": "vitest run",
    "check-build": "./scripts/check-build.sh"
  },
  "devDependencies": {
    "@types/node": "22.13.1",
    "prettier": "3.6.2",
    "ts-proto": "2.11.5",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.10.1",
    "@grpc/grpc-js": "1.14.3"
  },
  "packageManager": "pnpm@10.33.0"
}
